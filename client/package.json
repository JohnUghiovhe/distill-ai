    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8",
    "storybook": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@storybook/addon-a11y": "^10.4.6",
