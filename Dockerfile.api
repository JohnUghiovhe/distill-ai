# Stage 1 — install deps and compile TypeScript
# Debian (glibc) rather than Alpine (musl): `pdf-parse` pulls in `@napi-rs/canvas`, whose prebuilt
# native binding is glibc-only. On Alpine the binding fails to load and pdf.js then throws
# `ReferenceError: DOMMatrix is not defined` at require time, killing the worker process.
FROM node:22-slim AS builder
WORKDIR /app
RUN npm install -g pnpm@11
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
# client/package.json is required for pnpm workspace resolution; client deps are not installed
COPY client/package.json ./client/package.json
RUN pnpm install --frozen-lockfile --filter !client
COPY src/ ./src/
COPY tsconfig*.json nest-cli.json ./
RUN pnpm build

# Stage 2 — slim production runtime (no devDeps, no source files)
FROM node:22-slim AS runner
WORKDIR /app
RUN npm install -g pnpm@11
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY client/package.json ./client/package.json
RUN pnpm install --frozen-lockfile --prod --filter !client
COPY --from=builder /app/dist ./dist
COPY events.schema.json ./events.schema.json
COPY config/ ./config/
# Create the object-store root in the image so the shared named volume inherits `node` ownership on
# first mount; Docker would otherwise create it root-owned and the runtime user could not write.
# Ownership is scoped to that directory rather than a recursive chown of /app: it is the only path
# written at runtime (attachments and generated quotes both live under it), so leaving dist/ and
# node_modules root-owned keeps them read-only to the runtime user and avoids duplicating the whole
# dependency tree into an extra image layer.
RUN mkdir -p /app/var/object-store && chown -R node:node /app/var
USER node
EXPOSE 3000
# `node -e` rather than wget/curl: the Debian slim image ships neither, and Node 22 has global fetch.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
